  "Cython cdef class with __cinit__ and __dealloc__": {
    "prefix": "cdefclassfull",
    "body": [
      "cdef class ${1:ClassName}:",
      "    cdef public ${2:object} ${3:attr}",
      "",
      "    def __cinit__(self):",
      "        ${0:# initialization code}",
      "",
      "    def __dealloc__(self):",
      "        ${0:# cleanup code}"
    ],
    "description": "Cython cdef class with __cinit__, __dealloc__, and public attribute"
