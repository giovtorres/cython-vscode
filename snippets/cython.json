  "Cython gil block": {
    "prefix": "gil",
    "body": [
      "with gil:",
      "    ${0:# code with GIL}"
    ],
    "description": "Cython gil block"
  },
  "Cython prange loop": {
    "prefix": "prange",
    "body": [
